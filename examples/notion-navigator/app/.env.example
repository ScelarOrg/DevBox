# Copy to /.env (or /.env.local) and restart the preview after changes.

# Auth (optional overrides — defaults work in the sandbox)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Comma-separated extra Origins for Better Auth CSRF (Nodepod preview host is included by default)
TRUSTED_ORIGINS=

# Email — without these, sendEmail writes to /.scelar/mail (Email workbench tab)
RESEND_API_KEY=
EMAIL_FROM=
